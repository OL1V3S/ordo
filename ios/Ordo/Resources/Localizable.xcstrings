    "capture.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These details are locked so a retry sends exactly the same save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos están bloqueados para que un reintento envíe exactamente el mismo movimiento."
          }
        }
      }
    },
