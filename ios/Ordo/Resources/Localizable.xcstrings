      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t confirm whether this was deleted. Retry sends the delete again; repeating it is safe. Or check the list to see what is saved."
          }
