    "capture.persistFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t prepare this save on your phone, so nothing was sent. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos preparar este movimiento en tu teléfono, así que no se envió nada. Inténtalo de nuevo."
          }
        }
      }
    },
    "capture.recordDeleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original was deleted, and nothing new was saved. Check Home if you want to add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original se eliminó y no se guardó nada nuevo. Revisa Inicio si quieres agregarlo de nuevo."
