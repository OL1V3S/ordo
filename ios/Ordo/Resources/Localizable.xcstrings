    "budgets.explanation.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits start over on %1$@. Each limit covers one calendar month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites empiezan de nuevo el %1$@. Cada límite cubre un mes calendario."
          }
        }
      }
    },
    "budgets.explanation.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About monthly limits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
