    "budgets.explanation.zeroLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A zero limit is an intentional no-spend budget. It is different from having no budget for a category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite en cero es un presupuesto intencional sin gastos. Es diferente a no tener un presupuesto para una categoría."
          }
        }
      }
    },
