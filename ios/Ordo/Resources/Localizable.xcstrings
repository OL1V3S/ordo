        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmar si se eliminó. “Reintentar” vuelve a enviar la eliminación; es seguro repetirla. También puedes revisar la lista para ver qué está guardado."
          }
        }
      }
    },
