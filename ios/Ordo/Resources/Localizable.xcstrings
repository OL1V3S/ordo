    "analytics.summary.about.composition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed paychecks are deposits linked to one of your pay schedules, including active, paused, and ended ones. Other deposits are all the rest and can include unlinked paychecks, refunds, transfers, and reimbursements. Both count toward Deposits; a deposit isn’t counted as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos de nómina confirmados son depósitos vinculados a uno de tus calendarios de nómina, incluidos los activos, en pausa y finalizados. Otros depósitos son todos los demás y pueden incluir pagos de nómina sin vincular, devoluciones, transferencias y reembolsos. Ambos cuentan en Depósitos; un depósito no se cuenta como ingreso."
          }
        }
      }
    },
    "analytics.summary.about.coverage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These figures come from the transactions you saved and may not include all account activity. Deposits minus spending describes this period; it isn’t an account balance, savings, or money available to spend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cifras vienen de los movimientos que guardaste y pueden no incluir toda la actividad de la cuenta. Depósitos menos gastos describe este periodo; no es un saldo de la cuenta, ahorros ni dinero disponible para gastar."
          }
        }
      }
    },
    "analytics.summary.about.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts and dates reflect the transactions you have saved now. Editing or deleting a transaction can change past figures. Confirming a possible paycheck changes the deposits breakdown, but not total deposits or deposits minus spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los montos y las fechas reflejan los movimientos que tienes guardados ahora. Editar o eliminar un movimiento puede cambiar cifras anteriores. Confirmar un posible pago de nómina cambia el desglose de los depósitos, pero no el total de depósitos ni depósitos menos gastos."
          }
        }
      }
    },
    "analytics.summary.about.rounding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linked deposits you edit stay linked and use their current date and amount. Percentages are rounded to the nearest tenth, with halves rounded up, so rounded shares may not add up to 100.0%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los depósitos vinculados que edites siguen vinculados y usan su fecha y monto actuales. Los porcentajes se redondean a la décima más cercana (las mitades hacia arriba), así que los porcentajes redondeados pueden no sumar 100.0%."
          }
        }
      }
    },
    "analytics.summary.about.spending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent includes all the money you recorded going out, such as purchases, transfers, debt payments, and money put into investments. Refunds count as deposits and don’t reduce the spending in their original category. Budgets, expected paychecks, expected recurring expenses, and unsaved import previews aren’t included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastado incluye todo el dinero que registraste como salida, como compras, transferencias, pagos de deudas y dinero que pasaste a inversiones. Las devoluciones cuentan como depósitos y no reducen el gasto de su categoría original. No se incluyen los presupuestos, los pagos de nómina esperados, los gastos recurrentes esperados ni las vistas previas de importación sin guardar."
          }
        }
      }
    },
    "analytics.summary.about.summary": {
