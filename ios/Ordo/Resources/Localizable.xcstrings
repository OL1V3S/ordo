{
  "sourceLanguage": "en",
  "strings": {
    "app.notConfigured.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build doesn’t have a valid server address, so it can’t connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no tiene una dirección de servidor válida, así que no puede conectarse."
          }
        }
      }
    },
    "app.notConfigured.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordo isn’t set up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordo no está configurado"
          }
        }
      }
    },
    "app.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes conexión. Revisa tu conexión e inténtalo de nuevo."
