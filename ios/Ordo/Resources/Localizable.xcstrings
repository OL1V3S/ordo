    "capture.saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando…"
          }
        }
      }
    },
    "capture.signOutWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save is still waiting and may already be saved. Signing out discards it. Check Home after you sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un movimiento pendiente que quizá ya se guardó. Al cerrar sesión se descarta. Revisa Inicio cuando inicies sesión."
          }
        }
      }
    },
    "capture.uncertain.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t confirm whether this was saved. Retry to send it again; if it was already saved, it won’t be added twice. Or discard it and check Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmar si se guardó. Reintenta para enviarlo de nuevo; si ya se guardó, no se agregará dos veces. O descártalo y revisa Inicio."
          }
        }
      }
    },
    "capture.uncertain.recoveredMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save from earlier may not have finished. Retry to send it again; if it was already saved, it won’t be added twice. Or discard it and check Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un movimiento anterior puede no haberse guardado por completo. Reintenta para enviarlo de nuevo; si ya se guardó, no se agregará dos veces. O descártalo y revisa Inicio."
          }
        }
      }
    },
    "capture.uncertain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t confirm this save"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmar este movimiento"
          }
        }
      }
    },
    "capture.unreadable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t read a save that was waiting on this phone. Discard it, then check Home before adding it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leer un movimiento pendiente en este teléfono. Descártalo y revisa Inicio antes de agregarlo de nuevo."
          }
        }
      }
    },
