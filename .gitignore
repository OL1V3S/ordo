# -----------------
# .NET / C# ignores
# -----------------

# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio files
.vs/

# Rider IDE files (if used)
.idea/

# Logs
*.log

#appsettings
**/appsettings.Development.json

# ---------------------
# Node / React / Vite
# ---------------------

# Node modules
frontend/node_modules/

# Vite build output
frontend/dist/

# Playwright E2E output and the per-run test account (#336)
frontend/playwright-report/
frontend/test-results/
frontend/e2e/.state/

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.*

# npm logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ---------------------
# Other
# ---------------------

# Ignore packages folder if using NuGet package restore
packages/

# Ignore publish output
publish/

# macOS system files
.DS_Store

# ---------------------
# iOS (Xcode)
# ---------------------

ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/*.xcresult
ios/build/
ios/DerivedData/
ios/Config/Local.xcconfig
